# Copy to .env.local and fill in. Never commit real values.
# Client-side (bundled by Vite — must be prefixed VITE_):
VITE_POCKETBASE_URL=
VITE_CARTO_API_KEY=
VITE_VAPID_PUBLIC_KEY=
# Optional; defaults to package.json's version (Settings → About).
VITE_APP_VERSION=

# Server-side only (read by the PocketBase backend in pb/ and by the catalog
# build script; never bundled into the client):
# NEPTUN_ENCRYPTION_KEY, FUTAR_API_KEY
# VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
