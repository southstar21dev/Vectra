<?xml version="1.0" encoding="utf-8"?>
<!-- The class in progress: glass lit from inside in the accent, with an accent rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#F2FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:type="radial" android:centerX="0.4" android:centerY="0.45" android:gradientRadius="100%"
                android:startColor="#3338BDF8" android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#7038BDF8" />
        </shape>
    </item>
</layer-list>
