<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup="false" stopped applying to device transfer on Android 12. The session is sealed with a
     Keystore key that doesn't move between devices, so nothing is copied either way. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
