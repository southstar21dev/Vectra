      "ios": { "rimTop": "white@0.12", "rimMid": "white@0.06" },
      "android": { "stroke": "#12FFFFFF", "highlight": "#1CFFFFFF" }
    },
    "light": {
      "top": "#FFFFFF", "bottom": "#F4F6FA",
